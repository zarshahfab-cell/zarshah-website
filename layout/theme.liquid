<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#0D1B2A">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
        The shop name is added only when the SEO title doesn't already contain it (product SEO titles end in
        "— Zarshah"). The homepage falls back to Theme settings → SEO & sharing when Online Store → Preferences
        has no homepage title or meta description.
    {%- endcomment -%}
    {%- liquid
        assign base_title = page_title | strip
        if request.page_type == 'index' and base_title == shop.name and settings.seo_home_title != blank
            assign seo_title = settings.seo_home_title | strip
        elsif base_title == shop.name
            assign seo_title = shop.name
            if shop.description != blank
                assign seo_title = seo_title | append: ' — ' | append: shop.description
            endif
        else
            assign seo_title = base_title
            if current_tags
                assign tag_list = current_tags | join: ', '
                assign seo_title = seo_title | append: ' – tagged "' | append: tag_list | append: '"'
            endif
            if current_page != 1
                assign seo_title = seo_title | append: ' – Page ' | append: current_page
            endif
            unless base_title contains shop.name
                assign seo_title = seo_title | append: ' | ' | append: shop.name
            endunless
        endif
    -%}
    <title>{{ seo_title | strip_newlines | escape_once }}</title>

    {%- if request.page_type == 'search' or request.page_type == 'cart' %}
    <meta name="robots" content="noindex, follow">
    {%- endif %}

    {%- liquid
        assign meta_description = page_description
        if meta_description == blank and request.page_type == 'index'
            assign meta_description = settings.seo_home_description
        endif
    -%}
    {%- if meta_description != blank %}
    <meta name="description" content="{{ meta_description | strip_html | strip_newlines | escape_once }}">
    {%- endif %}

    {%- comment -%} Before content_for_header, so WhatsApp and Facebook pick up this page's tags first {%- endcomment -%}
    {%- render 'meta-tags' -%}
    {%- render 'structured-data' -%}

    {%- comment -%} Right-sized icons (the 1656px logo was downloaded three times as the favicon) {%- endcomment -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon-180.png' | asset_url }}">

    {%- comment -%}
        Urdu (Noto Nastaliq Urdu) is loaded by the hero section with only the letters of its headline
        (234KB → a few KB). Bebas Neue and Amiri weren't used by any element.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>window.routes = { cart_add_url: '{{ routes.cart_add_url }}', cart_change_url: '{{ routes.cart_change_url }}', cart_url: '{{ routes.cart_url }}' };</script>

    {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">

<!-- Splash Screen (about 1.3 s, on a device's first homepage visit only) -->
{% if template == 'index' %}
<div class="splash-screen" id="splashScreen">
    <img src="{{ 'splash-logo-840h.webp' | asset_url }}" alt="{{ shop.name }}" class="splash-logo" width="906" height="840">
</div>
<script>
    /* Runs before first paint: show the splash once per device (it used to return every session). */
    try {
        if (localStorage.getItem('zarshahSplashSeen') || sessionStorage.getItem('zarshahSplashSeen')) {
            document.getElementById('splashScreen').remove();
        } else {
            localStorage.setItem('zarshahSplashSeen', '1');
            sessionStorage.setItem('zarshahSplashSeen', '1');
        }
    } catch (e) {}
</script>
{% endif %}

<!-- Theme Toggle -->
<button type="button" class="theme-toggle" id="themeToggle" onclick="toggleTheme()" aria-label="Toggle theme">
    <span class="theme-toggle-icon" id="themeIcon">&#127769;</span>
</button>

<!-- Background overlay -->
<div class="bg-overlay" style="position: fixed; inset: 0; background: radial-gradient(ellipse at center, rgba(13, 27, 42, 0.75) 0%, rgba(13, 27, 42, 0.92) 70%, rgba(5, 12, 20, 0.97) 100%); z-index: 0; pointer-events: none;"></div>

<div class="page-wrapper">

<!-- Scroll Progress Bar -->
<div class="scroll-progress" id="scrollProgress"></div>

<!-- Cursor Trail Dots -->
<div class="cursor-dot" id="cursorDot1"></div>
<div class="cursor-dot" id="cursorDot2"></div>
<div class="cursor-dot" id="cursorDot3"></div>
<div class="cursor-dot" id="cursorDot4"></div>
<div class="cursor-dot" id="cursorDot5"></div>

{% section 'navbar' %}
{% section 'announcement-bar' %}

<main role="main">
    {{ content_for_layout }}
</main>

{% section 'footer' %}

</div>

{% section 'social-floats' %}
{% if template == 'index' %}
  {% section 'discount-popup' %}
{% endif %}

<script src="{{ 'theme.js' | asset_url }}" defer></script>

</body>
</html>
